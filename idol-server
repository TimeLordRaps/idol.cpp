#!/bin/sh
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if [ -f "$ROOT/.venv/bin/python3" ]; then
    exec "$ROOT/.venv/bin/python3" "$ROOT/tools/idol_server.py" "$@"
elif [ -f "$ROOT/.venv/bin/python" ]; then
    exec "$ROOT/.venv/bin/python" "$ROOT/tools/idol_server.py" "$@"
else
    exec python3 "$ROOT/tools/idol_server.py" "$@"
fi
